# ===========================================
# Pokojowo Frontend - Environment Variables
# ===========================================
# For Vercel deployment, set these in the Vercel dashboard
# under Project Settings > Environment Variables

# ===========================================
# REQUIRED - API Configuration
# ===========================================

# Backend API URL (your Render backend URL)
# Used for Google OAuth redirects
VITE_API_URL=https://your-backend.onrender.com

# API base URL for regular API calls
# Use relative path '/api' if using Vercel rewrites, or full URL
VITE_API_BASE_URL=/api

# Public origin used for canonical tags and language alternate URLs
VITE_SITE_URL=https://pokojowo.com

# Server-only Vercel sitemap source (the production CloudFront API)
SITEMAP_API_URL=https://dh3iw703m1vvi.cloudfront.net/api

# ===========================================
# REQUIRED - WebSocket Configuration
# ===========================================

# Socket.io server URL for notifications (likes, saved searches)
VITE_SOCKET_URL=https://your-backend.onrender.com

# Chat microservice URLs (falls back to main API / socket when unset)
VITE_CHAT_API_URL=https://your-chat-service.onrender.com/api
VITE_CHAT_SOCKET_URL=https://your-chat-service.onrender.com

# ===========================================
# Build Configuration
# ===========================================

NODE_ENV=production

# Sentry runtime configuration (the DSN is public by design; never put the
# upload auth token in VITE_* variables).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=pokojowo-web@<commit-sha>

# Build-only source-map upload secrets (set in CI/Vercel, never commit them).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
