{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api",
        "EXPO_PUBLIC_SOCKET_URL": "http://localhost:3000",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pokojowo-web-project.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://pokojowo-web-project.onrender.com",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://pokojowo-web-project.onrender.com"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.pokojowo.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.pokojowo.com",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://api.pokojowo.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@email.com",
        "ascAppId": "your-app-store-connect-app-id"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json"
      }
    }
  }
}
