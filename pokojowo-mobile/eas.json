{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api",
        "EXPO_PUBLIC_SOCKET_URL": "http://localhost:3000",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "http://localhost:3000",
        "EXPO_PUBLIC_CHAT_API_URL": "http://localhost:3000/api",
        "EXPO_PUBLIC_CHAT_SOCKET_URL": "http://localhost:3000",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dh3iw703m1vvi.cloudfront.net/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_CHAT_API_URL": "https://dh3iw703m1vvi.cloudfront.net/api",
        "EXPO_PUBLIC_CHAT_SOCKET_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dh3iw703m1vvi.cloudfront.net/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_IMAGE_BASE_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_CHAT_API_URL": "https://dh3iw703m1vvi.cloudfront.net/api",
        "EXPO_PUBLIC_CHAT_SOCKET_URL": "https://dh3iw703m1vvi.cloudfront.net",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production"
      }
    }
  }
}
