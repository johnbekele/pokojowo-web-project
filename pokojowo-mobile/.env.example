# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
# Base URL for server-hosted images (defaults to EXPO_PUBLIC_SOCKET_URL)
EXPO_PUBLIC_IMAGE_BASE_URL=http://localhost:3000

# EAS Build
EAS_PROJECT_ID=your-eas-project-id

# Google OAuth (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Android Maps SDK key; without it react-native-maps renders blank on Android.
# iOS uses Apple Maps and needs no key. Set the same name as an EAS environment
# variable so release builds pick it up.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-android-maps-api-key
