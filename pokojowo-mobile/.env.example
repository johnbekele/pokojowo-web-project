# API Configuration
# Shared backend behind CloudFront. Works on any network, and one host covers
# the API, both sockets and uploaded images. Point these at http://localhost:8000
# (chat on :8002) when running the backend on your own machine.
EXPO_PUBLIC_API_URL=https://dh3iw703m1vvi.cloudfront.net/api
EXPO_PUBLIC_SOCKET_URL=https://dh3iw703m1vvi.cloudfront.net
# Chat service; both default to the values above, which CloudFront routes for us.
# Set them only when the chat service runs somewhere else, e.g. locally.
# EXPO_PUBLIC_CHAT_API_URL=
# EXPO_PUBLIC_CHAT_SOCKET_URL=
# Base URL for server-hosted images (defaults to EXPO_PUBLIC_SOCKET_URL)
EXPO_PUBLIC_IMAGE_BASE_URL=https://dh3iw703m1vvi.cloudfront.net

# EAS Build
EAS_PROJECT_ID=your-eas-project-id

# Google OAuth (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Android Maps SDK key; without it react-native-maps renders blank on Android.
# iOS uses Apple Maps and needs no key. Set the same name as an EAS environment
# variable so release builds pick it up.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-android-maps-api-key
