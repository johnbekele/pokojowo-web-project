# Pokojowo Scraper v2 — all settings are prefixed SCRAPER_ (see src/pokojowo_scraper/config.py)

# Storage (scraper's own DB, separate from the main app's)
SCRAPER_MONGO_URI=mongodb://localhost:27017
SCRAPER_MONGO_DB=pokojowo_scraper

# Main backend — publish target.
# SCRAPER_POKOJOWO_API_KEY must equal SCRAPER_API_KEY in pokojowo-fastapi/.env
SCRAPER_POKOJOWO_API_URL=http://localhost:3000
SCRAPER_POKOJOWO_API_KEY=

# Dashboard API authentication. Use separate values for read access and
# moderation/run-trigger actions; the dashboard UI receives these as Vite vars.
SCRAPER_DASHBOARD_API_KEY=
SCRAPER_DASHBOARD_ADMIN_KEY=
SCRAPER_DASHBOARD_RUN_COOLDOWN_SECONDS=60

# Local LLM (translation + classification fallback)
SCRAPER_OLLAMA_URL=http://localhost:11434
SCRAPER_OLLAMA_MODEL=gemma3:12b-it-qat

# Scrape targets & politeness
SCRAPER_CITIES=["warszawa","krakow","wroclaw","poznan","gdansk","lodz"]
SCRAPER_PAGE_CAP=5
SCRAPER_REQ_DELAY_MIN=3
SCRAPER_REQ_DELAY_MAX=6

# Quality routing thresholds
SCRAPER_AUTO_PUBLISH_THRESHOLD=0.85
SCRAPER_QUEUE_THRESHOLD=0.60

# Optional: cache fetched HTML to disk (useful while developing extractors)
# SCRAPER_HTML_CACHE_DIR=tests/fixtures/cache
