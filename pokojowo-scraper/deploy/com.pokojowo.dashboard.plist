<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keeps the scraper dashboard API alive on port 8001.
       Install like com.pokojowo.scraper.plist (edit paths first). -->
  <key>Label</key>
  <string>com.pokojowo.dashboard</string>

  <key>WorkingDirectory</key>
  <string>/Users/yohansbekele/pokojowo-web-project/pokojowo-scraper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yohansbekele/pokojowo-web-project/pokojowo-scraper/.venv-v2/bin/uvicorn</string>
    <string>pokojowo_scraper.api.app:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8001</string>
  </array>

  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/pokojowo-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pokojowo-dashboard.err.log</string>
</dict>
</plist>
